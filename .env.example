# Copy to `.env` and adjust. Real env vars (e.g. docker -e) override these.

# Shard/worker count (rounded up to a power of two). Defaults to CPU count.
WORKERS=4

# Auth: set BOTH to require credentials on handshake. Leave unset = auth off.
DATASET_USERNAME=admin
DATASET_PASSWORD=secret

# Log level: error | warn | info | debug | trace
RUST_LOG=info
